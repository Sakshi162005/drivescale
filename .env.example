NODE_ENV=development

PORT=5000

MONGODB_URI=mongodb://localhost:27017/drivescale

# Redis configuration
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# Distributed rate limiting (limits per window in ms)
RATE_LIMIT_GENERAL_LIMIT=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_INIT_LIMIT=20
RATE_LIMIT_UPLOAD_INIT_WINDOW_MS=60000

# BullMQ & Background Worker configuration
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRIES=3
BULLMQ_BACKOFF_DELAY_MS=2000
BULLMQ_COMPLETED_RETENTION_COUNT=100
BULLMQ_FAILED_RETENTION_COUNT=500
BULLMQ_FAILED_RETENTION_AGE_SECONDS=604800
BULLMQ_CLEANUP_INTERVAL_MS=3600000

# Trash & Recovery retention configuration (in days)
TRASH_RETENTION_DAYS=30
TRASH_CLEANUP_BATCH_SIZE=100

# Default storage quota for new users (in bytes, 10 GB = 10737418240)
DEFAULT_STORAGE_QUOTA_BYTES=10737418240

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=

# MinIO Object Storage configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drivescale
STORAGE_DRIVER=minio

CLIENT_URL=http://localhost:5173
